{
  "version": 2,
  "builds": [
    { "src": "*.php", "use": "vercel-php@0.7.3" }
  ],
  "routes": [
    { "src": "/webhook", "dest": "/webhook.php" },
    { "src": "/debug-sheet", "dest": "/debug-sheet.php" },
    { "src": "/debug-gemini", "dest": "/debug-gemini.php" },
    { "src": "/debug-full", "dest": "/debug-full.php" }
  ]
}
